# ---- FastAPI service ----
APP_NAME=Fraud Detection API
ENVIRONMENT=development
LOG_LEVEL=INFO
WEB_CONCURRENCY=2
FRAUD_THRESHOLD=0.5

# ---- MLflow / model registry ----
# Local run: http://localhost:5000 | Inside docker-compose: http://mlflow:5000 (set by compose)
MLFLOW_TRACKING_URI=http://localhost:5000
MODEL_NAME=FraudDetectionModel
# A version number ("1"), "latest", or a registry alias ("champion")
MODEL_VERSION=1

# ---- PostgreSQL (MLflow backend store) ----
POSTGRES_DB=mlflow_db
POSTGRES_USER=mlflow_user
POSTGRES_PASSWORD=mlflow_password
# Used by compose to build the MLflow backend store URI
DATABASE_URL=postgresql://mlflow_user:mlflow_password@db:5432/mlflow_db

# ---- Host ports ----
API_PORT=8000
MLFLOW_PORT=5000
